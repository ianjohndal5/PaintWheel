Keybinds: {
	OpenWheel.DisplayName: Открыть колесо красок
	Eyedropper.DisplayName: Пипетка для краски
	QuickToggleLastTwo.DisplayName: Вернуться к прошлой краске
	PreviousPalette.DisplayName: Предыдущая палитра
	NextPalette.DisplayName: Следующая палитра
	ToggleScrape.DisplayName: Режим скребка
	ToggleNoPaint.DisplayName: Переключить без краски
	PreviousPaint.DisplayName: Предыдущая краска
	NextPaint.DisplayName: Следующая краска
	SwapPaintTool.DisplayName: Сменить кисть и валик
	TogglePaintBoth.DisplayName: Переключить покраску блоков и стен
}

UI: {
	AutoPreset: Всё, что при вас
	NoCoating: Без покрытия
	NoPaint: Ставить блоки без краски
	NoPaintResume: Снова красить блоки
	NoPaintOn: Без краски
	NoPaintOff: С краской
	ScrollHint: Прокрутите или нажмите стрелки, чтобы увидеть ещё краски
	PaletteTitle: Палитры
	PaletteHint: Нажмите, чтобы сменить палитру
	PaletteScrollHint: Прокрутите или нажмите на название, чтобы сменить палитру
	Empty: закончилась
	NoPaints: Краски не загружены
	NoAutoPaint: Блоки не красятся без автопокраски
	SlotPickPaint: Нажмите {0}, чтобы выбрать эту краску
	SlotPickCoating: Нажмите {0}, чтобы выбрать это покрытие
	Disabled: В Paint Wheel произошла ошибка, и он больше не применяет вашу краску. Подробности в client.log.
	NewPalette: Новая палитра из того, что есть
	EditPalette: Изменить эту палитру
	DeletePalette: Удалить эту палитру
	EditHint: Нажмите на цвет, чтобы добавить или убрать его.
	DoneEditing: Готово
	NewPaletteName: Палитра
	EditingHeader: Изменение {0}
	ConfirmDelete: Нажмите ещё раз, чтобы удалить
	PaletteHintNew: Нажмите, чтобы открыть палитры
	RanOut: Закончилось: {0}
	PaintBoth: Красить блоки и стены любым инструментом
	PaintBothResume: Вернуть по половине на инструмент
	PaintBothOn: Блоки и стены
	PaintBothOff: Половина на инструмент
	NoToolToSwap: Нет предмета: {0}
	NewEmptyPalette: Новая пустая палитра
	RenamePalette: Переименовать эту палитру
	RenameHint: Enter — сохранить, Esc — отмена
	NothingToShow: Нет краски для выбора
	CloseInventory: Закройте инвентарь, чтобы открыть Paint Wheel

	Keys: {
		MouseLeft: левую кнопку мыши
		MouseRight: правую кнопку мыши
		MouseMiddle: среднюю кнопку мыши
		Mouse4: кнопку мыши 4
		Mouse5: кнопку мыши 5
	}

	Scrape: {
		Enter: Режим скребка
		Header: Режим скребка
		BlocksAndWalls: Блоки и стены
		BlocksOnly: Только блоки
		WallsOnly: Только стены
		CoatingsOnly: Только покрытия
		Exit: Назад к цветам
		NoScraper: Скребка для краски нет
	}
}

Configs: {
	PaintWheelConfig: {
		DisplayName: Настройки

		Language: {
			Label: Язык
			Tooltip:
				'''
				На каком языке текст этого мода. Автоматически - следовать настройке игры; остальные заставляют
				мод говорить на выбранном языке независимо от игры. Филиппинский есть в списке, потому что в
				Terraria такого языка нет.
				Применяется при сохранении. Эта страница перерисует свои подписи при следующем открытии.
				'''
		}

		Headers: {
			Input: Управление
			Shape: Выбор цвета
			Presets: Палитры
		}

		OpenWithRightClick: {
			Label: Открывать правой кнопкой
			Tooltip:
				'''
				Правая кнопка с малярным инструментом открывает колесо, а не применяет инструмент.
				Отключите, если правая кнопка нужна другому моду; горячая клавиша продолжит работать.
				'''
		}

		OpenMode: {
			Label: Поведение правой кнопки
			Tooltip: Держать ли колесо нажатой кнопкой или оставлять открытым, пока вы не закончите.
		}

		RequirePaintTool: {
			Label: Только с малярным инструментом
			Tooltip:
				'''
				Ограничивает колесо и его клавиши малярными инструментами (и блоками в руке, если надет
				краскопульт).
				'''
		}

		PlaySounds: {
			Label: Звуки
			Tooltip: Щелчок при переходе между цветами и звук подтверждения.
		}

		Layout: {
			Label: Форма выбора
			Tooltip: Кольцо цветов вокруг курсора, столбец полос рядом с ним или сетка со всеми цветами сразу.
		}

		Appearance: {
			Label: Размеры и внешний вид
			Tooltip: Насколько колесо большое и что оно рисует.
		}

		Supply: {
			Label: Показ запаса
			Tooltip: Как цвет показывает, сколько этой краски осталось.
		}

		Advanced: {
			Label: Дополнительно
			Tooltip: Поведение покраски, покрытия и запасной выход при конфликтах модов.
		}

		Presets: {
			Label: Палитры
			Tooltip:
				'''
				Сохранённые палитры, выбираются в списке, который открывается нажатием на центр колеса или на
				название палитры над ним. Одна палитра всегда заполняется сама всем, что у вас с собой.
				'''
		}
	}

	AppearanceSettings: {
		Tooltip: ""

		Headers: {
			Wheel: Колесо
			Bar: Полоса
		}

		ShowItemIcons: {
			Label: Показывать значки предметов
			Tooltip: Рисует банку краски поверх её цвета. По умолчанию выключено: вы выбираете именно цвет.
		}

		ShowBackgroundPanel: {
			Label: Рисовать фоновую панель
			Tooltip:
				'''
				По умолчанию выключено: цвета читаются лучше прямо на фоне мира. Включите, чтобы получить
				привычную полупрозрачную панель Terraria за ними.
				'''
		}

		ShowQuickKeys: {
			Label: Показывать цифровые клавиши на образцах
			Tooltip:
				'''
				Пока колесо открыто, цифровые клавиши выбирают первые десять образцов или строк вместо панели
				быстрого доступа. Здесь видно, какая клавиша что выбирает, как на самой панели.
				'''
		}

		ShowStackCounts: {
			Label: Показывать количество
			Tooltip: Сколько у вас каждой краски - на её образце, там, где ячейка инвентаря показывает стопку.
		}

		ShowCursorReadout: {
			Label: Показывать краску у курсора
			Tooltip:
				'''
				Маленькая метка у курсора там, где игра ничего не показывает: краска, которую блок получит от
				распылителя, переключатель блоков и стен на кисти или валике и то, что снимает скребок.
				'''
		}

		WheelRadius: {
			Label: Радиус колеса
			Tooltip:
				'''
				Расстояние от курсора до цветов, в пикселях. Считается минимумом: полное кольцо
				расширяется настолько, чтобы цвета не соприкасались.
				'''
		}

		SwatchSize: {
			Label: Размер образцов
			Tooltip: Диаметр каждого кружка цвета, в пикселях.
		}

		DeadZoneRadius: {
			Label: Мёртвая зона в центре
			Tooltip: Отпускание внутри этого радиуса отменяет выбор и оставляет прежнюю краску.
		}

		MaxSwatches: {
			Label: Цветов в кольце
			Tooltip:
				'''
				Больше двенадцати - и по цвету уже не попасть движением, поэтому двенадцать это предел.
				Остальное уходит на следующую страницу, а не пропадает.
				'''
		}

		OpenAnimationTicks: {
			Label: Длительность анимации
			Tooltip:
				'''
				Сколько колесо раскрывается, в тиках: 60 — одна секунда, 0 — мгновенно.
				Держите короткой, иначе оно кажется вялым.
				'''
		}

		BarCellWidth: {
			Label: Ширина полос
			Tooltip: Ширина каждой цветной полосы в режиме полосы.
		}

		BarCellHeight: {
			Label: Высота полос
			Tooltip: Высота каждой полосы. По высоким полосам легче попасть при движении.
		}

		BarSwatchesPerPage: {
			Label: Полос на странице
			Tooltip: Сколько цветов помещается на одной странице полосы до появления стрелок.
		}
	}

	SupplySettings: {
		Tooltip: ""

		FadeStartStack: {
			Label: Тускнеет начиная с
			Tooltip:
				'''
				Размер стопки, при котором цвет считается полным. Ниже он тускнеет, а его кольцо пустеет.
				Считается по всем ячейкам, так что две половины стопки учитываются верно.
				'''
		}

		MinimumSwatchOpacity: {
			Label: Наименьшая непрозрачность
			Tooltip: Насколько бледным может стать почти закончившийся цвет.
		}

		ShowDepletionRing: {
			Label: Кольцо малого запаса
			Tooltip:
				'''
				Кольцо точек вокруг цвета, которое пустеет по мере расхода краски. Появляется только
				когда стопка опускается ниже значения Тускнеет начиная с, чтобы колесо из полных стопок
				оставалось чистым. Поднимите это значение выше обычного размера стопки, чтобы видеть
				кольцо у всех цветов.
				'''
		}

		DepletionRingSegments: {
			Label: Точек в кольце
			Tooltip: Сколько точек в кольце. Отдельные точки лучше подходят к пиксельному стилю.
		}

		HideEmptySwatches: {
			Label: Скрывать пустые цвета
			Tooltip:
				'''
				По умолчанию выключено: пустой цвет сохраняет своё место, чтобы колесо не смещалось под
				рукой посреди стройки. Включите, чтобы убирать их.
				'''
		}
	}

	AdvancedSettings: {
		Tooltip: ""

		OverrideMode: {
			Label: Способ выбора краски
			Tooltip:
				'''
				Как мод навязывает ваш цвет коду покраски игры.
				Перехват стоит по умолчанию и никогда не трогает инвентарь.
				'''
		}

		FallBackToAnyPaintWhenEmpty: {
			Label: Брать любую краску, когда закончилась
			Tooltip:
				'''
				По умолчанию выключено. Когда выбранная краска кончается, покраска останавливается, а не
				тратит втихую другой цвет.
				'''
		}

		ShowCoatingRow: {
			Label: Показывать ряд покрытий
			Tooltip: Ряд под колесом для светящегося покрытия и эха, плюс выключатель.
		}

		AutoPaintPlacedTiles: {
			Label: Красить блоки при установке
			Tooltip:
				'''
				По умолчанию выключено, ведь это работа краскопульта, а его надо купить. Включённое
				означает, что каждый поставленный блок и стена получают ваш цвет и тратят краску как
				обычно; значок краскопульта в строительных переключателях выключает это обратно.
				'''
		}

		SmartCoating: {
			Label: Умный порядок покрытия
			Tooltip:
				'''
				Когда выбраны и цвет, и покрытие, накладывается то, чего цели не хватает, так что
				зажатая кнопка нанесёт оба. Выключено - покрытие всегда идёт первым.
				'''
		}
	}

	PaintPreset: {
		Tooltip: ""

		Name: {
			Label: Название
			Tooltip: Показывается над колесом, пока выбрана эта палитра.
		}

		Paints: {
			Label: Краски
			Tooltip: Нажмите на цвет, чтобы добавить или убрать его. Число - его место в кольце.
		}
	}

	WheelLayoutStyle: {
		Tooltip: ""

		Wheel: {
			Label: Колесо
			Tooltip: Цвета кольцом вокруг курсора, выбираются движением в их сторону.
		}

		Bar: {
			Label: Полоса
			Tooltip: Цвета столбцом рядом с курсором, выбираются движением вдоль него.
		}

		Grid: {
			Label: Сетка
			Tooltip: Все цвета рядами под курсором. Ничего не скрыто, поэтому полной палитре не нужны страницы.
		}
	}

	PickerOpenMode: {
		Tooltip: ""

		Hold: {
			Label: Удерживать для открытия
			Tooltip:
				'''
				Держите правую кнопку, ведите к цвету, отпустите для выбора. На экране ничего не остаётся
				и закрывать нечего.
				'''
		}

		Click: {
			Label: Открывать нажатием
			Tooltip:
				'''
				Одно нажатие правой кнопкой оставляет выбор открытым, держать не нужно. Нажатие на цвет
				выбирает его и закрывает; покрытия, палитры и режим скребка оставляют окно открытым,
				чтобы задать несколько вещей сразу. Правая кнопка ещё раз, Esc или щелчок мимо закроют его.
				'''
		}
	}

	PaintOverrideMode: {
		Tooltip: ""

		Detour: {
			Label: Перехват (рекомендуется)
			Tooltip:
				'''
				Перехватывает игровой поиск, который и выбирает, и тратит краску, поэтому нанесённый цвет
				и потраченная стопка не могут разойтись. Инвентарь никогда не перекладывается.
				'''
		}

		InventorySwap: {
			Label: Обмен в инвентаре (запасной)
			Tooltip:
				'''
				Переставляет вашу стопку в ячейку, которую выбрала бы игра, на долю тика и тут же
				возвращает обратно. Нужен, только если перехвату мешает другой мод.
				'''
		}
	}

	LanguageOverride: {
		Tooltip: ""

		Automatic: {
			Label: Автоматически
			Tooltip: ""
		}

		English: {
			Label: English
			Tooltip: ""
		}

		German: {
			Label: Deutsch
			Tooltip: ""
		}

		Spanish: {
			Label: Español
			Tooltip: ""
		}

		French: {
			Label: Français
			Tooltip: ""
		}

		Italian: {
			Label: Italiano
			Tooltip: ""
		}

		Polish: {
			Label: Polski
			Tooltip: ""
		}

		Portuguese: {
			Label: Português
			Tooltip: ""
		}

		Russian: {
			Label: Русский
			Tooltip: ""
		}

		Chinese: {
			Label: 简体中文
			Tooltip: ""
		}

		Filipino: {
			Label: Filipino
			Tooltip: ""
		}
	}
}
